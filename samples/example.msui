// Example server dialog UI
margin: 12

table {
  row
  label: "Enter your name:" {
    style: outlineLabel
    wrap: true
    colspan: 2
    align: center
    labelAlign: center
  }

  image: router
  row

  field: "" {
    id: "nameField"
    hint: "Player name"
    maxLength: 32
    growX: true
    grow: false
    padBottom: 10
    color: "ff0079"
  }

  row
  condition: "width >= 400"
  check: "Enable bingus mode" {
    id: "hardcore"
    checked: false

  }

  row
  slider {
    min: 0
    max: 1
    step: 0.1
    id: "volume"
    defaultValue: 0.5
    style: defaultSlider
  }
  buttonTable {
    id: "asdf"
    size: 100
    image: "cat"
  }
}

row
row
table {
  fillX: true
  defaults {
    growX: true
    pad: 4
    padBottom: 3
  }
  button: "asdf" {

  }
  button: "Cancel" {
    clicked: "cancel"
    style: grayt
    width: 100
    height: 60
  }
  button: "OK" {
    clicked: "ok"
    style: defaultt
    // intentional issues below, for testing diagnostics:
    // 1) unknown property on button
    //floop: true
    // 2) unknown style name
    // style: notARealStyle
  }
}